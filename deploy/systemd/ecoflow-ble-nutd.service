[Unit]
Description=EcoFlow BLE NUT-compatible daemon
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
LoadCredential=ecoflow-ble-nutd.conf:/etc/ecoflow-ble-nutd.conf
ExecStart=/usr/local/bin/ecoflow-ble-nutd -config ${CREDENTIALS_DIRECTORY}/ecoflow-ble-nutd.conf
Restart=on-failure
RestartSec=5
User=ecoflow-ble-nutd
Group=ecoflow-ble-nutd
DynamicUser=no
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run
MemoryMax=64M

[Install]
WantedBy=multi-user.target
